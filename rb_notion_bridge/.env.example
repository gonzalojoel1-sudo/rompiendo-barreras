# =============================================================================
# notion_bridge/.env.example
# =============================================================================
# Plantilla de variables de entorno para el bridge Orca <-> Notion.
#
# INSTRUCCIONES:
#   1. Copiar a .env en el mismo directorio:  cp .env.example .env
#   2. Rellenar NOTION_API_KEY con tu token de integracion.
#   3. Nunca commitear el .env real.
# =============================================================================


# -----------------------------------------------------------------------------
# Requerido
# -----------------------------------------------------------------------------

# Token de integracion de Notion.
#   - Crear en: https://www.notion.so/my-integrations
#   - Compartir cada database/pagina objetivo con la integracion
#     (boton "..." > "Add connections").
NOTION_API_KEY=ntn_REEMPLAZAR-CON-TU-TOKEN-DE-INTEGRACION


# -----------------------------------------------------------------------------
# Opcionales (valores por defecto razonables)
# -----------------------------------------------------------------------------

# Version de la API de Notion. No cambiar salvo que Notion lo indique.
NOTION_API_VERSION=2022-06-28

# Timeout HTTP por peticion al SDK (segundos).
NOTION_TIMEOUT=30

# Numero maximo de reintentos ante 429 (rate limit) o 5xx (server error).
# 0 = sin reintentos. Recomendado: 3.
NOTION_MAX_RETRIES=3

# Base del backoff exponencial (segundos). Formula: base * 2^(attempt-1).
# Con base=0.5 y max_retries=3, los delays seran aprox: 0.5s, 1s, 2s.
NOTION_BACKOFF_BASE=0.5

# Tope maximo del backoff para no esperar mas de esto entre reintentos.
NOTION_BACKOFF_MAX=8.0
