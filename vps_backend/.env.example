# =============================================================================
# vps_backend/.env.example
# =============================================================================
# Plantilla de variables de entorno para el backend Rompiendo Barreras.
#
# INSTRUCCIONES:
#   1. Copiar a .env en el mismo directorio:  cp .env.example .env
#   2. Rellenar cada valor real (NUNCA commitear el .env resultante).
#   3. En producción, el .env vive en /etc/rbapi/rbapi.env con permisos 0600.
#
# Leyenda:
#   [ACTUAL]   -> Leído por el código presente (orca_memory_bridge.py / memory_manager.py)
#   [FUTURO]   -> Requerido por la spec vps_backend_spec.md pero NO implementado aún
# =============================================================================


# -----------------------------------------------------------------------------
# [ACTUAL] Aplicación base
# -----------------------------------------------------------------------------

# Clave de API de OpenAI. Usada por memory_manager.py para el modelo primario
# (gpt-4o) y para la auto-compresión (gpt-4o-mini).
OPENAI_API_KEY=sk-REEMPLAZAR-CON-TU-KEY-DE-OPENAI

# Token Bearer que los agentes de Orca envían en el header Authorization para
# invocar los endpoints privados /api/v1/orca/*. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVER_ADMIN_SECRET=REEMPLAZAR-CON-TOKEN-ALEATORIO-DE-48-CHARS-MIN

# API key de Orca (Sprint 4). Se envia en el header `X-Orca-API-Key` para
# autenticar TODOS los endpoints /api/v1/orca/*. Comparacion timing-safe.
# Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ORCA_API_KEY=REEMPLAZAR-CON-API-KEY-DE-32-CHARS-MIN

# Token de integracion de Notion (Sprint 2 - sync bidireccional).
# Si esta vacio, el SyncManager se desactiva y los endpoints /sync/* devuelven 503.
# Generar en: https://www.notion.so/my-integrations
NOTION_API_KEY=ntn_REEMPLAZAR-CON-TOKEN-DE-NOTION

# TTL de la cache de schemas de Notion en memoria (segundos). 900 = 15 min.
NOTION_SCHEMA_CACHE_TTL=900


# -----------------------------------------------------------------------------
# [Sprint 5] Squad Multi-Proveedor LLM
# -----------------------------------------------------------------------------
# Cada proveedor alimenta un subagente del Squad (ver DEFAULT_AGENT_MODELS en
# vps_backend/llm_client.py). Las claves son opcionales: si todas faltan, el
# pipeline corre con stubs deterministicos. Si una sola existe, el subagente
# correspondiente se ejecuta en el proveedor real.

# OpenCode Go API - Sprint 14: REMOVIDO del pipeline por defecto.
# Razon: el endpoint publico https://api.opencode.ai/v1 NO EXISTE (devuelve
# "Not Found" como texto plano). El provider "opencode" ya no aparece en
# PROVIDER_CONFIGS, pero el codigo del cliente sigue preparado para soportarlo
# si en el futuro OpenCode expone un endpoint valido (basta con re-anadir
# "opencode" a PROVIDER_CONFIGS en llm_client.py).
#
# OpenCode fue reemplazado por MiniMax m2.7-highspeed (ultra-rapido) para
# trend_hunter y guardian, manteniendo OpenAI-style calls en el cliente.

# MiniMax API (modelos minimax/*: minimax-m3, minimax-m2.7-highspeed, etc.)
# URL oficial: api.minimaxi.chat. Si tu suscripcion usa Group ID, anade:
#   MINIMAX_GROUP_ID=tu-group-id
MINIMAX_API_KEY=REEMPLAZAR-CON-TU-KEY-DE-MINIMAX
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1
# MINIMAX_GROUP_ID=

# Google Generative Language (Gemini REST nativo, sprint 7).
# Acepta claves de Google Cloud Console (AQ.Ab8...) y de AI Studio (AIzaSy...).
# Auth: query param ?key= y header x-goog-api-key. No usa Bearer.
GOOGLE_CLOUD_API_KEY=REEMPLAZAR-CON-TU-KEY-DE-GOOGLE
GOOGLE_CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta


# -----------------------------------------------------------------------------
# [Sprint 8] Vertex AI (Google Cloud) con service account
# -----------------------------------------------------------------------------
# Usado por copywriter y guardian (modelos Gemini con OAuth2).
# Path al JSON de service account descargado de Google Cloud Console.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Project ID (alternativa: auto-detectado del JSON si esta vacio)
GOOGLE_CLOUD_PROJECT=

# Region de Vertex AI (us-central1 por defecto)
GOOGLE_CLOUD_REGION=global


# -----------------------------------------------------------------------------
# [Sprint 14] Override por subagente (opcional)
# -----------------------------------------------------------------------------
# Formato 1 (single): SQUAD_<ROLE>_MODEL=provider/model
# Formato 2 (chain):  SQUAD_<ROLE>_MODEL_CHAIN=p1/m1,p2/m2,p3/m3
#
# Chain por defecto (sprint 14):
#   trend_hunter: minimax/minimax-m2.7-highspeed
#   strategist:   minimax/minimax-m3
#   copywriter:   vertex/gemini-3.5-flash -> vertex/claude-sonnet-4-5 -> minimax/minimax-m3
#   guardian:     minimax/minimax-m2.7-highspeed -> vertex/gemini-3.5-flash-lite
#
# Ejemplos:
# SQUAD_TREND_HUNTER_MODEL=minimax/minimax-m3
# SQUAD_TREND_HUNTER_MODEL_CHAIN=minimax/minimax-m3,vertex/gemini-3.5-flash
# SQUAD_COPYWRITER_MODEL=vertex/gemini-3.5-flash
# SQUAD_GUARDIAN_MODEL=vertex/gemini-3.5-flash-lite
# SQUAD_COPYWRITER_MODEL_CHAIN=vertex/claude-sonnet-4-5,minimax/minimax-m3


# -----------------------------------------------------------------------------
# [ACTUAL - Sprint 2] Rolling Scratchpad
# -----------------------------------------------------------------------------

# Tamano maximo del agent_scratchpad.json antes de la rotacion automatica.
# Default 50 KB; suficiente para miles de eventos.
SCRATCHPAD_MAX_BYTES=50000

# Maximo de decisiones_clave retenidas tras la rotacion.
SCRATCHPAD_MAX_DECISIONES=10

# Maximo de eventos retenidos en event_log tras la rotacion.
SCRATCHPAD_MAX_EVENTOS=100

# Timeout (segundos) del file lock al escribir el scratchpad.
SCRATCHPAD_LOCK_TIMEOUT=10


# -----------------------------------------------------------------------------
# [FUTURO - spec §3.1] Autenticación de alumnos (JWT)
# -----------------------------------------------------------------------------

# Secret para firmar/verificar tokens JWT de login de alumnos.
# DISTINTO del SERVER_ADMIN_SECRET. Generar con secrets.token_urlsafe(64).
JWT_SECRET=REEMPLAZAR-CON-OTRO-SECRET-DIFERENTE-AL-DE-ARRIBA
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24


# -----------------------------------------------------------------------------
# [FUTURO - spec §2] Base de datos SQL
# -----------------------------------------------------------------------------

# Dev (SQLite local):    sqlite:///./rompiendo_barreras.db
# Prod (Postgres):       postgresql+psycopg2://rbapi:CLAVE@127.0.0.1:5432/rb_db
DATABASE_URL=sqlite:///./rompiendo_barreras.db

# Pool de conexiones (solo aplica a Postgres/asyncpg en prod)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10


# -----------------------------------------------------------------------------
# [FUTURO - spec §3.2] Email transaccional (bienvenida + recuperación)
# -----------------------------------------------------------------------------

# Servicio SMTP genérico. Para Gmail usar App Password (no la contraseña real).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@tu-dominio.com
SMTP_PASSWORD=REEMPLAZAR-CON-APP-PASSWORD
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@tu-dominio.com
SMTP_FROM_NAME="Rompiendo Barreras"


# -----------------------------------------------------------------------------
# [FUTURO - spec §3.2] Pasarelas de pago
# -----------------------------------------------------------------------------

# MercadoPago (Link de Tarjeta, principal mercado AR)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-REEMPLAZAR

# Stripe (tarjeta internacional, suscripciones recurrentes)
STRIPE_SECRET_KEY=sk_test_REEMPLAZAR
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZAR

# PayPal (alternativa)
PAYPAL_CLIENT_ID=REEMPLAZAR
PAYPAL_CLIENT_SECRET=REEMPLAZAR
PAYPAL_MODE=sandbox


# -----------------------------------------------------------------------------
# [FUTURO - spec] Bunny Stream (metadata y firmado de URLs de video)
# -----------------------------------------------------------------------------

# No almacena MP4 en el VPS. Sirve para firmar URLs temporales y leer metadata.
BUNNY_STREAM_API_KEY=REEMPLAZAR
BUNNY_STREAM_LIBRARY_ID=REEMPLAZAR
BUNNY_STREAM_TOKEN_AUTH_KEY=REEMPLAZAR


# -----------------------------------------------------------------------------
# [ACTUAL] Entorno y operación
# -----------------------------------------------------------------------------

# Modo de ejecución: development | production
APP_ENV=production

# Bind del uvicorn (interno, expuesto vía Nginx)
APP_HOST=127.0.0.1
APP_PORT=8000

# Dominio público (usado para construir URLs absolutas en emails y CORS)
DOMAIN=api.tu-dominio.com

# Orígenes CORS permitidos (CSV). Según spec §1.3, SOLO estos orígenes.
ALLOWED_ORIGINS=https://tu-dominio.com,https://app.tu-dominio.com

# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# [FUTURO - spec §3.4] Cron de Drip Content
# -----------------------------------------------------------------------------

# Secret que valida las invocaciones del cron job que libera pilares nuevos
# (semanal). Debe coincidir con el header enviado por el cron externo.
DRIP_CRON_SECRET=REEMPLAZAR-CON-OTRO-SECRET-ALEATORIO


# -----------------------------------------------------------------------------
# [REFERENCIA] No es env var, pero debe existir en el deploy:
#   - config/prompts_agentes_orca.md   (system prompts de los 4 agentes)
#   - config/system_prompt_orquestador.md (preamble del orquestador)
#   - manifests/notion_databases_manifest.json (IDs de las 4 DBs Notion)
#   - agent_scratchpad.json (estado dinámico)
#   - rompiendo_barreras_master_context.md (knowledge base)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# [ACTUAL] Bot de Telegram (Sprint 7)
# -----------------------------------------------------------------------------

# Token del bot de Telegram (@RompiendoBarreras_bot). Solicitarlo a @BotFather.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Chat IDs autorizados a usar el bot (CSV). Para activar tu chat personal, mandale /start y pone el chat_id aqui.
# Ejemplo: TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
TELEGRAM_ALLOWED_CHAT_IDS=

# Nivel de log del bot: DEBUG, INFO, WARNING, ERROR
TELEGRAM_LOG_LEVEL=INFO

# URL del endpoint /api/v1/orca/webhook/trigger del backend.
# Local (docker compose):   http://orca_backend:8765/api/v1/orca/webhook/trigger
# Produccion (VM + Nginx):  https://api.rompiendo-barreras.com/api/v1/orca/webhook/trigger
# REQUERIDO desde Fase 4 commit da566b9 (C-05: no hardcoded IP).
WEBHOOK_TRIGGER_URL=http://orca_backend:8765/api/v1/orca/webhook/trigger

# ID de la base de Notion "Ideas" que el bot sincroniza (opcional, con default interno).
IDEAS_DB_ID=
